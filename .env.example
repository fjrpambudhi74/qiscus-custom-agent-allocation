# Qiscus Omnichannel credentials (from dashboard Settings > App Settings)
QISCUS_APP_ID=your_app_id
QISCUS_SECRET_KEY=your_secret_key

# Base URL for Qiscus Multichannel API - bare host only. Each endpoint path
# in app/qiscus_client.py includes its own API version (v1 vs v2 differ).
QISCUS_BASE_URL=https://multichannel.qiscus.com

# Business rules
DEFAULT_MAX_CAPACITY=2
POLL_INTERVAL_SECONDS=30

# Storage
DATABASE_URL=sqlite:///./allocation.db
